# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Database (PostgreSQL)
# Local: postgresql://usuario:senha@localhost:5432/corretora
# Render: copie a "Internal Connection String" do banco PostgreSQL criado no dashboard
DATABASE_URL=postgresql://usuario:senha@localhost:5432/corretora

# CORS
CORS_ORIGIN=http://localhost:5173
